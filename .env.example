# GoHighLevel (GHL) API v2 Integration
GHL_LOCATION_ID=your_ghl_location_id_here
GHL_ACCESS_TOKEN=your_ghl_access_token_here

# Plaionn Sports Group API Integration
# The live deployed URL of the Plaionn Next.js app (e.g. https://plionn.vercel.app)
PLAIONN_API_URL=https://your-plaionn-deployment.vercel.app
# Optional shared secret key (matches PLAIONN_VEDDIE_API_KEY on Plaionn)
PLAIONN_API_KEY=your_shared_plaionn_api_key_here

# (Optional Direct Supabase Connection to Plaionn)
# PLAIONN_SUPABASE_URL=https://your-supabase-ref.supabase.co
# PLAIONN_SUPABASE_ANON_KEY=your-supabase-anon-key
